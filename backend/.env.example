# 复制为 backend/.env 后填写。不要提交真实密钥。
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3

# 留空时根据 DASHSCOPE_WORKSPACE_ID 生成北京地域文本排序 Endpoint。
RERANKER_BASE_URL=
RERANKER_MODEL=qwen3.7-text-rerank
RERANKER_TIMEOUT=30
RERANKER_MAX_RETRIES=2
RERANKER_CANDIDATE_K=20
RERANKER_DOCUMENT_MAX_CHARS=1200

# 默认 simple 不调用云端 Reranker；在前端显式选择 cloud 才会调用。
DEFAULT_RERANK=simple

# 四阶段上下文压缩与短期会话记忆。
CONTEXT_MAX_TOKENS=4000
MEMORY_TTL_SECONDS=86400
MEMORY_MAX_TURNS=6
